{
  "command": "node",
  "args": ["server.mjs"],
  "restart_policy": "always",
  "display_name": "kb",
  "description": "Knowledge graph standup pane (today's tasks with done, snooze, +7d, skip), record viewer, and session journal.",
  "has_web_ui": true,
  "env": {
    "UI_THEME_VERSION": "1"
  },
  "ui_config": {
    "display_name": "kb",
    "views": [
      {
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "path": "/",
        "title": "kb"
      },
      {
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_SIDEBAR",
        "path": "/",
        "title": "kb"
      }
    ]
  }
}
